<html lang="no">
<%- include("./partials/head.ejs") %>

<style>
  @view-transition {
    navigation: auto;
  }
</style>

<body>
  <%- include("./partials/nav.ejs") %>
  <!-- gir deg en liten melding som sier at du har sendt et svar -->
  <% if (submitted || eksisterendeSvar) { %>

  <section class="section status">
    <% if (submitted) { %>
    <h2>Svaret ditt er sendt inn!</h2>
    <p>Tusen takk for at du deltar ♡</p>
    <% } %>

    <% if (eksisterendeSvar) { %>
    <h2>Du har allerede svart på dette spørsmålet.</h2>
    <% } %>
  </section>

  <% } %>
  <!-- det meste teksten på luke sidene er dynamisk, så blir puttet inn med js. den tar infoen fra databasen den er koblet til. spesifikt fra "luke" kolleksjonen. -->
  <section class="section lukeSide">

    <div class="lukeTopp">
      <span class="lukeLabel">BLEIKER JULEKALENDER</span>
      <span class="lukeDato">24 dager med jul ♡</span>
      <% if (vinner && vinner.userId) { %>
      <div class="vinnerInfo">
        <span class="vinnerLabel">Dagens vinner er <%= vinner.userId.navn %> Gratulerer!</span>
      </div>
      <% } %>
    </div>

    <h1>Luke <%= luke.lukeNr %></h1>
    <h2><%= luke.tittel %></h2>

    <%
      // henter spørsmålet fra luke i db
      const sporsmalstekst = luke.sporsmal;
    %>

    <% if (sporsmalstekst) { %>
    <div class="sporsmalBoks">
      <p><%= sporsmalstekst %></p>
    </div>
    <% } %>

  </section>

  <!-- en if statement, hvis mediatype er bilde skal den vise det bildet. hvis det er video, viser den videoen. så det er bare synlig hvis det er noe der. -->
  <% if ((luke.mediaType === "bilde" || luke.mediaType === "video") && luke.media) { %>

  <section class="section media">
    <span class="sectionLabel">DAGENS MEDIA</span>

    <% if (luke.mediaType === "bilde") { %>
    <img src="<%= luke.media %>" alt="Bilde til luke <%= luke.lukeNr %>">
    <% } %>

    <% if (luke.mediaType === "video") { %>
    <video controls>
      <source src="<%= luke.media %>">
      Nettleseren din støtter ikke video.
    </video>
    <% } %>
  </section>

  <% } %>



  <% if (loggedIn && sporsmalstekst) { %>

  <section class="section form svarBoks">
    <span class="sectionLabel">SVAR</span>

    <h2>Send inn svaret ditt</h2>

    <form action="/luke/<%= luke.lukeNr %>/svar" method="post">

      <% if (luke.svarType === "multiple_choice") { %>

      <h3>Velg svaret ditt:</h3>

      <!-- for each loop for at hvert alternativ skal få en id. går gjennom alt i seed -->
      <% (luke.alternativer || []).forEach((option, index) => { %>

      <!-- labelen gjør at man kan trykke på teksten OG radioknappen for å velge et svar -->
      <label class="option" for="alternativ<%= index %>">

        <!-- radio knapp som lar eleven velge svar -->
        <input type="radio" name="svar" id="alternativ<%= index %>" value="<%= option %>" required>

        <span><%= option %></span>
      </label>

      <% }); %>

      <!-- hvis det ikke er et alternativt svar, er det åpent. -->
      <% } else { %>

      <label for="svar">Skriv svaret ditt:</label>

      <textarea name="svar" id="svar" placeholder="Skriv ditt svar her..." required></textarea>

      <% } %>

      <button type="submit">Send inn svaret ♡</button>
    </form>
  </section>

  <% } %>

  <!-- script for en popup hvis man går inn på en luke uten å være logget inn. siden det er !loggedIn, vises den bare hvis man ikke er logget inn. -->
  <% if (!loggedIn) { %>

  <div class="loginPopup" id="loginPopup">
    <div class="loginPopupInnhold">

      <button type="button" class="closePopup" onclick="closePopup()">
        ×
      </button>

      <span class="sectionLabel">VENT LITT!</span>
      <h2>Å nei!</h2>
      <h3>Du er ikke logget inn!</h3>

      <p>
        For å delta i julekalenderen og sende inn svar, må du logge inn
        med din skole-E-post.
      </p>

      <a href="/login" class="popupButton">Logg inn her ♡</a>

      <button type="button" class="senere" onclick="closePopup()">
        Kanskje senere
      </button>

    </div>
  </div>

  <script src="/js/popup.js"></script>

  <% } %>

</body>

</html>