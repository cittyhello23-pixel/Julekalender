<html lang="no">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

  <!-- det meste teksten på luke sidene er dynamisk, så blir puttet inn med js. den tar infoen fra databasen den er koblet til. spesifikt fra "luke" kolleksjonen.-->
  <h1>Luke <%= luke.lukeNr %></h1>
  <h2><%= luke.tittel %></h2>

  <% 
    // Hvis læreren har skrevet inn et eget spørsmål i editoren,
    // bruker vi det. Ellers bruker vi spørsmålet fra seed-scriptet.
    const sporsmalstekst = luke.sporsmal || quizSporsmal?.question;
  %>

  <% if (sporsmalstekst) { %>
  <p><%= sporsmalstekst %></p>
  <% } %>

  <!-- Viser svaralternativer hvis spørsmålet er multiple choice. -->
  <% if (quizSporsmal?.type === "multiple_choice") { %>
  <ul>
    <% quizSporsmal.options.forEach((option) => { %>
    <li><%= option %></li>
    <% }); %>
  </ul>
  <% } %>

  <!-- Viser videolenken fra seed-scriptet. -->
  <% if (quizSporsmal?.type === "video" && quizSporsmal.video_url) { %>
  <p>
    <a href="<%= quizSporsmal.video_url %>" target="_blank" rel="noopener noreferrer">
      Se videoen
    </a>
  </p>
  <% } %>

  <!-- en if statement, hvis mediatype er bilde skal den vise det bildet. hvis det er video, viser den videoen. så det er bare synlig hvis det er noe der. -->
  <% if (luke.mediaType === "bilde" && luke.media) { %>
  <img src="<%= luke.media %>" alt="Bilde til luke <%= luke.lukeNr %>">
  <% } %>

  <% if (luke.mediaType === "video" && luke.media) { %>
  <video controls>
    <source src="<%= luke.media %>">
    Nettleseren din støtter ikke video.
  </video>
  <% } %>

</body>

</html>