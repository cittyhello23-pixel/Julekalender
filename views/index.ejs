<html lang="en">
<%- include("./partials/head") %>

<body>
  <%- include("./partials/nav") %>
  <div class="kalender">
    <% for (let i = 1; i <= 24; i++) { %>
    <% if (i < dagensDato) { %>
    <a href="/luke/<%= i %>" class="luke fortid">
      <%= i %>
    </a>
    <% } else if (i === dagensDato) {
    %>
    <a href="/luke/ <%= i %>" class="luke idag">
      <%= i %>
    </a>
    <% } else { %>
    <div class="luke framtid">
      <%= i %>
    </div>
    <% } %>

    <%  } %>
  </div>
</body>

</html>