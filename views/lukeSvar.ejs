<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

  <h1>Deltakere svar</h1>
  <form action="/lukeSvar" method="get">
    <label for="lukeFilter">Sorter etter luke:</label>
    <select name="lukeNr" id="lukeFilter">
      <option value="">Alle luker</option>

      <% for (let i = 1; i <= 24; i++) { %>
      <option value="<%= i %>">
        Luke <%= i  %>
      </option>
      <% } %>
    </select>
    <button type="submit">Sorter</button>
  </form>
  <% if (svar.length === 0) { %>
  <p>Ingen svar er sendt inn enda.</p>
  <% } else { %>

  <% svar.forEach(function(s) { %>
  <div class="svar">
    <h2>Luke <%= s.lukeNr %></h2>


    <p>Elev svar: <%= s.svar %></p>

    <p>Riktig svar: <%= s.riktigSvar %></p>
    <p>
      Status:
      <% if (s.riktig === true) { %>
      Riktig
      <% } else if (s.riktig === false) { %>
      Feil
      <% } else { %>
      Ikke vurdert
      <% } %>
    </p>
    <p>Deltaker-ID: <%= s.userId %></p>

    <p>
      Sendt inn:
      <%= s.createdAt
              ? new Date(s.createdAt).toLocaleString("no-NO")
              : "Ukjent" %>
    </p>
  </div>
  <hr>
  <% }); %>

  <% } %>
</body>

</html>